AIFROST_HOST=127.0.0.1
AIFROST_PORT=8787
# Auth: bearer (default) | none (local only — no Authorization header)
# AIFROST_AUTH=none
AIFROST_AUTH=bearer
AIFROST_AUTH_TOKEN=dev-token-change-me
# mock | chromium | brave | auto  — use auto/brave for real ChatGPT (not mock)
AIFROST_BROWSER=auto
# Harness-local tools: auto (coding→tool_calls, chat→WebUI) | always | never
# AIFROST_HARNESS_TOOLS=auto
# History: stateful (default, harness-friendly) | strict (tests only)
# AIFROST_HISTORY_MODE=stateful
# Optional binary overrides (auto-detects Brave/Chrome on macOS)
# AIFROST_CHROMIUM_BIN=
# AIFROST_BRAVE_BIN=
# ChatGPT requires headed Brave (CF blocks headless). Default: headed (0/false).
# Set AIFROST_HEADLESS=1 only for experiments / soft sites.
AIFROST_HEADLESS=0
# One Aifrost Brave process per account_id; many agents = tabs in that process.
# Cap concurrent agent tabs per account (default 10, max 50).
# AIFROST_MAX_TABS_PER_ACCOUNT=10
# Keep account Brave up while serve runs even after last agent exits (default).
# Set 1 only if you want the browser to quit when idle.
# AIFROST_BROWSER_IDLE_EXIT=0
# ChatGPT WebUI project for all agents on an account (default: aifrost).
# Ensures project exists, opens new agent chats inside it. Set none to use top-level chats.
# AIFROST_CHATGPT_PROJECT=aifrost
# Harness PE for WebUI tools: compact (default, TOON-ish catalog) | legacy (verbose)
# AIFROST_HARNESS_PROTOCOL=compact
# Self-enforced ChatGPT Web rate limit (per account). See docs/chatgpt-rate-limits.md
# Modes: interactive | agentic (default) | smoke | off
# AIFROST_RATE_LIMIT=agentic
# AIFROST_RATE_MIN_SUBMIT_GAP_MS=10000
# AIFROST_RATE_MAX_INFLIGHT=1
# AIFROST_RATE_ROLLING_MAX_SUBMITS=24
# AIFROST_RATE_ROLLING_WINDOW_MS=900000
# AIFROST_RATE_COOLDOWN_MS=300000
AIFROST_STATE_DIR=./state
AIFROST_LOG_LEVEL=info
